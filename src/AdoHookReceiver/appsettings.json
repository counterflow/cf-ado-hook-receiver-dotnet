{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "AdoHook": {
    "Username": "",
    "Password": "",
    "BodyLimitBytes": 5242880,
    "Allow": {
      "EventTypes": [],
      "Organizations": [],
      "ProjectIds": [],
      "SubscriptionIds": []
    }
  }
}
