# Copy to .env and fill in. .env is git-ignored and never baked into the image.
# Lists take one variable per entry: __0, __1, ...

AdoHook__Username=ado
AdoHook__Password=change-me

# Required: the event types, organisations and projects this receiver accepts.
AdoHook__Allow__EventTypes__0=git.pullrequest.created
AdoHook__Allow__EventTypes__1=git.push
AdoHook__Allow__Organizations__0=https://dev.azure.com/your-org/
AdoHook__Allow__ProjectIds__0=00000000-0000-0000-0000-000000000000

# Optional: also restrict to these service hook subscriptions.
# AdoHook__Allow__SubscriptionIds__0=00000000-0000-0000-0000-000000000000

# Optional overrides.
# AdoHook__BodyLimitBytes=5242880
# Logging__LogLevel__Default=Information
